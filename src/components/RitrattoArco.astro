---
// Ritratto ritagliato ad arco, con un contorno salvia "fuori registro"
// come un disegno ripassato a matita.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  priorita?: boolean;
  posizione?: string;
  sizes?: string;
  widths?: number[];
}
const { src, alt, priorita = false, posizione = '50% 30%', sizes = '(min-width: 64rem) 30rem, 80vw', widths = [360, 560, 800, 1100] } = Astro.props;
---
<figure class="arco" style={`--posizione: ${posizione}`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths}
    sizes={sizes}
    loading={priorita ? 'eager' : 'lazy'}
    fetchpriority={priorita ? 'high' : 'auto'}
  />
</figure>

<style>
  .arco {
    --forma: 50% 50% 1.1rem 1.1rem / 40% 40% 1.1rem 1.1rem;
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    isolation: isolate;
  }
  .arco :global(picture),
  .arco :global(img) {
    width: 100%;
    height: 100%;
  }
  .arco :global(img) {
    object-fit: cover;
    object-position: var(--posizione);
    border-radius: var(--forma);
    background: var(--sabbia);
  }
  .arco::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--salvia);
    border-radius: var(--forma);
    transform: translate(0.9rem, -0.8rem) rotate(1.6deg);
    pointer-events: none;
    z-index: -1;
  }
</style>
