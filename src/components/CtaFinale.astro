---
import { url } from '../lib/url';
import { sito } from '../data/sito';
import T from './T.astro';
---
<section class="cta sezione" aria-labelledby="cta-titolo">
  <div class="contenitore cta__interno">
    <T as="h2" id="cta-titolo" k="cta.titolo" />
    <div class="cta__azioni">
      <a class="btn" href={url('/contatti/')}>Prenota un primo colloquio</a>
      <p class="tenue">oppure telefona al <a href={sito.telefonoLink}><T k="dati.telefono" /></a></p>
    </div>
    <T as="p" class="cta__nota tenue" k="cta.nota" />
  </div>
</section>

<style>
  .cta {
    padding-top: 0;
  }
  .cta__interno {
    display: grid;
    gap: 1.75rem;
  }
  .cta__interno::before {
    content: '';
    border-top: 1px solid var(--filetto);
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .cta h2 {
    max-width: 16em;
  }
  .cta__azioni {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .cta__azioni p {
    margin: 0;
  }
  .cta__nota {
    font-size: var(--t-piccolo);
    max-width: 38em;
    margin: 0;
  }
</style>
