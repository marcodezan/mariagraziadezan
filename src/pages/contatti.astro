---
import Base from '../layouts/Base.astro';
import Tratto from '../components/Tratto.astro';
import FormContatto from '../components/FormContatto.astro';
import { Picture, Image } from 'astro:assets';
import { sito } from '../data/sito';
import T from '../components/T.astro';
import ritratto from '../assets/foto/maria-grazia-de-zan-psicologa-acilia-ritratto.jpg';
import fotoStanza from '../assets/foto/studio-psicologa-acilia-stanza.jpg';

const s = sito.studio;
const recapiti = [
  { etichetta: 'Telefono', chiave: 'dati.telefono', href: sito.telefonoLink },
  { etichetta: 'WhatsApp', chiave: 'dati.telefono', href: sito.whatsappLink, esterno: true },
  { etichetta: 'Email', chiave: 'dati.email', href: `mailto:${sito.email}` },
];
---
<Base
  titolo="Contatti | Psicologa ad Acilia e online | Dott.ssa Maria Grazia De Zan"
  descrizione="Per fissare un primo colloquio: telefono, WhatsApp, email o modulo di contatto. Studio ad Acilia (Roma) presso Poliofficina, colloqui anche online."
>
  <section class="apertura">
    <div class="contenitore apertura__riga">
      <div>
        <T as="h1" k="contatti.titolo" />
        <Tratto class="apertura__tratto" />
        <T as="p" class="apertura__lead" k="contatti.lead" />
      </div>
      <Image
        class="apertura__foto"
        src={ritratto}
        alt="Maria Grazia De Zan, psicologa"
        widths={[160, 320]}
        sizes="(min-width: 64rem) 8.5rem, 5.5rem"
        loading="eager"
      />
    </div>
  </section>

  <div class="contenitore contatti">
    <div class="contatti__info">
      <!-- Recapiti diretti -->
      <section aria-labelledby="recapiti-titolo">
        <h2 id="recapiti-titolo" class="sr-only">Recapiti</h2>
        <ul class="recapiti">
          {recapiti.map((r) => (
            <li>
              <a href={r.href} rel={r.esterno ? 'noopener' : undefined}>
                <span class="recapiti__etichetta">{r.etichetta}</span>
                <T class="recapiti__valore" k={r.chiave} />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Studio -->
      <section class="studio" aria-labelledby="studio-titolo">
        <T as="h2" id="studio-titolo" k="contatti.studioTitolo" />
        <address>
          presso <T k="dati.presso" /><br />
          <T k="dati.via" /><br />
          <T k="dati.cap" /> <T k="dati.citta" /> (<T k="dati.quartiere" />)
        </address>
        <a class="btn btn--contorno studio__mappa" href={s.mappaLink} rel="noopener">Apri in Google Maps</a>
        <T as="p" class="tenue studio__online" k="contatti.online" />
        <Picture
          class="studio__foto"
          src={fotoStanza}
          alt="La stanza dei colloqui ad Acilia, con sedie rosa, un tavolino e quadri botanici alla parete"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 640, 1000]}
          sizes="(min-width: 64rem) 32rem, 92vw"
        />
      </section>
    </div>

    <!-- Modulo -->
    <section class="contatti__modulo" aria-labelledby="modulo-titolo">
      <T as="h2" id="modulo-titolo" k="contatti.moduloTitolo" />
      <FormContatto />
    </section>
  </div>
</Base>

<style>
  /* Base: telefono */
  .apertura {
    padding-block: clamp(1.5rem, 6vw, 4.5rem) 1.5rem;
  }
  .apertura__riga {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: start;
  }
  .apertura h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.6vw, 3.8rem);
  }
  .apertura :global(.apertura__tratto) {
    width: min(11rem, 70%);
    height: 1.1rem;
    margin: 0.9rem 0 1.25rem;
  }
  .apertura__lead {
    grid-column: 1 / -1;
    max-width: 34em;
  }
  .apertura__riga > div {
    display: contents;
  }
  .apertura__riga h1,
  .apertura__riga :global(.apertura__tratto) {
    grid-column: 1;
  }
  .apertura :global(.apertura__foto) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--salvia);
  }

  .contatti {
    display: grid;
    gap: 3rem;
    padding-bottom: var(--sezione);
  }

  /* Recapiti: righe grandi, tutta la riga è toccabile */
  .recapiti {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto);
  }
  .recapiti li {
    border-top: 1px solid var(--filetto);
  }
  .recapiti a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-block: 0.85rem;
    text-decoration: none;
    color: var(--testo);
  }
  .recapiti__etichetta {
    font-size: var(--t-piccolo);
    color: var(--testo-tenue);
  }
  .recapiti__valore {
    font-family: var(--titoli);
    font-size: 1.3rem;
    color: var(--terracotta-scuro);
    overflow-wrap: anywhere;
  }
  .recapiti a:hover .recapiti__valore {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* Studio */
  .studio {
    margin-top: 2.5rem;
  }
  .studio h2 {
    font-size: var(--t-l);
    margin-bottom: 0.75rem;
  }
  address {
    font-style: normal;
  }
  .studio__mappa {
    margin-top: 1.1rem;
  }
  .studio__online {
    margin-top: 1rem;
  }
  .studio :global(.studio__foto img),
  .studio :global(img.studio__foto) {
    margin-top: 1.5rem;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--raggio);
  }

  /* Modulo */
  .contatti__modulo h2 {
    font-size: var(--t-l);
    margin-bottom: 1rem;
  }

  /* Desktop: recapiti e studio a sinistra, modulo a destra */
  @media (min-width: 64rem) {
    .apertura :global(.apertura__foto) {
      width: 8.5rem;
      height: 8.5rem;
    }
    .contatti {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .contatti__modulo {
      padding: 2rem;
      background: #fff;
      border: 1px solid var(--filetto);
      border-radius: var(--raggio);
    }
  }
</style>
