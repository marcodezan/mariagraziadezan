---
import Base from '../layouts/Base.astro';
import Tratto from '../components/Tratto.astro';
import RitrattoArco from '../components/RitrattoArco.astro';
import CtaFinale from '../components/CtaFinale.astro';
import T from '../components/T.astro';
import Paragrafi from '../components/Paragrafi.astro';
import ritratto from '../assets/foto/maria-grazia-de-zan-psicologa-roma.avif';


---
<Base
  titolo="Chi sono | Dott.ssa Maria Grazia De Zan, psicologa ad Acilia e online"
  descrizione="Psicologa clinica con formazione sistemico-relazionale e oltre quindici anni di esperienza tra studio, scuola e famiglie. Il mio percorso e il mio approccio."
>
  <!-- Apertura -->
  <section class="apertura">
    <div class="contenitore apertura__griglia">
      <div>
        <h1>Sono <span class="nome">Maria Grazia De&nbsp;Zan,</span> psicologa clinica.</h1>
        <Tratto class="apertura__tratto" />
        <T as="p" class="apertura__lead" k="chiSono.lead" />
      </div>
      <div class="apertura__foto">
        <RitrattoArco
          src={ritratto}
          alt="Ritratto di Maria Grazia De Zan, psicologa, sorridente su uno sfondo chiaro"
          priorita
          posizione="48% 35%"
          sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 20rem, 60vw"
        />
      </div>
    </div>
  </section>

  <!-- La mia storia: formazione ed esperienze in un unico racconto -->
  <section class="sezione" aria-labelledby="storia-titolo">
    <div class="contenitore due-colonne">
      <T as="h2" id="storia-titolo" k="chiSono.percorsoTitolo" />
      <Paragrafi class="storia" k="chiSono.percorso" />
    </div>
  </section>

  <!-- Approccio -->
  <section class="sezione approccio" aria-labelledby="approccio-titolo">
    <div class="contenitore due-colonne">
      <T as="h2" id="approccio-titolo" k="chiSono.approccioTitolo" />
      <Paragrafi class="misura" k="chiSono.approccio" />
    </div>
  </section>

  <CtaFinale />
</Base>

<style>
  /* Apertura */
  .apertura {
    padding-block: clamp(1.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
  }
  .apertura__griglia {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .apertura__foto {
    order: -1;
    width: min(42%, 11rem);
    margin-inline: auto 1rem;
  }
  @media (min-width: 64rem) {
    .apertura__griglia {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
    .apertura__foto {
      order: 0;
      width: 100%;
      max-width: 24rem;
      margin: 0;
    }
  }
  .apertura h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.6vw, 3.8rem);
    max-width: 14em;
  }
  @media (min-width: 40rem) {
    .apertura h1 .nome {
      white-space: nowrap;
    }
  }
  .apertura :global(.apertura__tratto) {
    width: min(16rem, 60%);
    height: 1.2rem;
    margin: 1rem 0 1.5rem;
  }
  .apertura__lead {
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem);
    max-width: 34em;
  }

  .approccio {
    background: var(--sabbia);
  }

  /* Racconto in prosa continua */
  .storia {
    max-width: var(--misura);
  }
</style>
