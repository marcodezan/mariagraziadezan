---
import Base from '../layouts/Base.astro';
import Tratto from '../components/Tratto.astro';
import CtaFinale from '../components/CtaFinale.astro';
import { aree } from '../data/sito';
import T from '../components/T.astro';
import Paragrafi from '../components/Paragrafi.astro';

---
<Base
  titolo="Aree di intervento | Psicologa ad Acilia e online | Dott.ssa Maria Grazia De Zan"
  descrizione="Sostegno alla genitorialità, DSA e ADHD, adolescenza, coppia e famiglia, disturbi dell'umore. Colloqui psicologici ad Acilia (Roma) e online."
>
  <section class="apertura">
    <div class="contenitore">
      <T as="h1" k="areePagina.titolo" />
      <Tratto class="apertura__tratto" />
      <T as="p" class="apertura__lead" k="areePagina.intro" />
    </div>
  </section>

  <div class="contenitore aree">
    <nav class="indice" aria-label="Aree in questa pagina">
      <ul>
        {aree.map((a, i) => <li><a href={`#${a.id}`}><T k={`aree.${i}.titolo`} /></a></li>)}
      </ul>
    </nav>

    <div class="aree__testi">
      {aree.map((a, i) => (
        <section id={a.id} class="area" aria-labelledby={`${a.id}-titolo`}>
          <T as="h2" id={`${a.id}-titolo`} k={`aree.${i}.titolo`} />
          <Paragrafi k={`aree.${i}.testo`} />
          {a.id === 'adolescenza' && <T as="p" class="area__nota" k="areePagina.notaMinori" />}
        </section>
      ))}
    </div>
  </div>

  <CtaFinale />
</Base>

<style>
  /* Base: telefono */
  .apertura {
    padding-block: clamp(1.5rem, 6vw, 4.5rem) 1.5rem;
  }
  .apertura h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.6vw, 3.8rem);
  }
  .apertura :global(.apertura__tratto) {
    width: min(14rem, 60%);
    height: 1.1rem;
    margin: 0.9rem 0 1.25rem;
  }
  .apertura__lead {
    max-width: 34em;
  }

  /* Indice: link grandi e facili da toccare */
  .indice ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--filetto);
  }
  .indice li {
    border-top: 1px solid var(--filetto);
  }
  .indice a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-block: 0.5rem;
    font-family: var(--titoli);
    font-size: 1.2rem;
    color: var(--testo);
    text-decoration: none;
  }
  .indice a:hover {
    color: var(--terracotta-scuro);
  }

  .aree__testi {
    margin-top: 1rem;
  }
  .area {
    padding-block: 2.25rem;
    max-width: var(--misura);
  }
  .area + .area {
    border-top: 1px solid var(--filetto);
  }
  .area h2 {
    font-size: var(--t-l);
    margin-bottom: 0.9rem;
  }
  .area__nota {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    background: var(--sabbia-chiara);
    border-radius: var(--raggio);
    font-size: var(--t-piccolo);
    color: var(--testo-tenue);
  }

  /* Desktop: indice fisso a sinistra, testi a destra */
  @media (min-width: 64rem) {
    .aree {
      display: grid;
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .indice {
      position: sticky;
      top: 2rem;
      margin-top: 2.25rem;
    }
    .indice a {
      font-size: 1.1rem;
    }
    .aree__testi {
      margin-top: 0;
    }
    .area h2 {
      font-size: var(--t-xl);
    }
  }
</style>
