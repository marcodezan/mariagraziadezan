---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Tratto from '../components/Tratto.astro';
import CtaFinale from '../components/CtaFinale.astro';
import { sito } from '../data/sito';
import { testi } from '../lib/testi';
import T from '../components/T.astro';
import Paragrafi from '../components/Paragrafi.astro';

const domande = testi.faq.domande as { domanda: string; risposta: string[]; mostra?: string }[];
const fraseTariffe = `Le tariffe per incontro sono: ${sito.tariffe
  .map((t) => `${t.voce.toLowerCase()} ${t.prezzo}\u00a0€`)
  .join(', ')}.`;

// Dati strutturati FAQ per Google: solo le risposte complete (senza segnaposto)
const datiFaq = {
  '@type': 'FAQPage',
  mainEntity: domande
    .filter((d) => !d.risposta.join(' ').includes('[DA '))
    .map((d) => ({
      '@type': 'Question',
      name: d.domanda,
      acceptedAnswer: {
        '@type': 'Answer',
        text: [d.mostra === 'tariffe' ? fraseTariffe : '', ...d.risposta].filter(Boolean).join(' '),
      },
    })),
};
---
<Base
  titolo="Domande frequenti | Psicologa ad Acilia e online | Dott.ssa Maria Grazia De Zan"
  descrizione="Durata degli incontri, studio o online, riservatezza, minorenni, costi e prenotazione: le risposte alle domande più frequenti."
  datiPagina={datiFaq}
>
  <section class="apertura">
    <div class="contenitore">
      <T as="h1" k="faq.titolo" />
      <Tratto class="apertura__tratto" />
      <T as="p" class="apertura__lead" k="faq.lead" />
    </div>
  </section>

  <section class="sezione faq-sezione" aria-label="Elenco delle domande">
    <div class="contenitore">
      <div class="faq">
        {domande.map((d, i) => (
          <details class="faq__voce">
            <summary><T k={`faq.domande.${i}.domanda`} /></summary>
            <div class="faq__risposta">
              {d.mostra === 'tariffe' && <p>{fraseTariffe}</p>}
              <Paragrafi k={`faq.domande.${i}.risposta`} />
              {d.mostra === 'contatti' && (
                <ul class="faq__contatti">
                  <li><a href={sito.telefonoLink}>Telefono {sito.telefono}</a></li>
                  <li><a href={sito.whatsappLink} rel="noopener">WhatsApp</a></li>
                  <li><a href={`mailto:${sito.email}`}>{sito.email}</a></li>
                  <li><a href={url('/contatti/')}>Pagina Contatti</a></li>
                </ul>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaFinale />
</Base>

<style>
  /* Base: telefono */
  .apertura {
    padding-block: clamp(1.5rem, 6vw, 4.5rem) 0;
  }
  .apertura h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.6vw, 3.8rem);
  }
  .apertura :global(.apertura__tratto) {
    width: min(14rem, 60%);
    height: 1.1rem;
    margin: 0.9rem 0 1.25rem;
  }
  .apertura__lead {
    max-width: 32em;
  }
  .faq-sezione {
    padding-top: 1.5rem;
  }

  .faq {
    max-width: 46rem;
    border-bottom: 1px solid var(--filetto);
  }
  .faq__voce {
    border-top: 1px solid var(--filetto);
  }
  .faq__voce summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.9rem;
    font-family: var(--titoli);
    font-size: 1.2rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  .faq__voce summary::-webkit-details-marker {
    display: none;
  }
  .faq__voce summary::after {
    content: '+';
    flex-shrink: 0;
    font-family: var(--corpo);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--terracotta-scuro);
    transition: transform 0.2s ease;
  }
  .faq__voce[open] summary::after {
    transform: rotate(45deg);
  }
  .faq__risposta {
    padding-bottom: 1.25rem;
    max-width: var(--misura);
  }
  .faq__risposta :global(p + p),
  .faq__risposta :global(p + div),
  .faq__risposta :global(div + ul) {
    margin-top: 0.75em;
  }
  .faq__contatti {
    margin: 0;
    padding-left: 1.2rem;
  }
  .faq__contatti li + li {
    margin-top: 0.3rem;
  }

  @media (min-width: 64rem) {
    .faq__voce summary {
      font-size: var(--t-m);
    }
  }
</style>
